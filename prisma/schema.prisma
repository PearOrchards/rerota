// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id   String @id @default(uuid())
  name String
  slug String @unique

  staffMembers StaffMember[]
  rides        Ride[]
  categories   Category[]
  tiers        Tier[]
  positions    Position[]
}

model StaffMember {
  id           String       @id @default(uuid())
  firstName    String
  lastName     String
  business     Business     @relation(fields: [businessId], references: [id])
  businessId   String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  competencies Competency[]
  identity     Identity?
}

model Category {
  id   String @id @default(uuid())
  name String

  businessId     String
  business       Business       @relation(fields: [businessId], references: [id])
  numberMatrixes NumberMatrix[]
}

model Tier {
  id    String @id @default(uuid())
  name  String
  order Int    @default(0)

  businessId     String
  business       Business       @relation(fields: [businessId], references: [id])
  numberMatrixes NumberMatrix[]
  rides          Ride[]
}

model Position {
  id    String @id @default(uuid())
  name  String
  order Int    @default(0)

  businessId     String
  business       Business       @relation(fields: [businessId], references: [id])
  numberMatrixes NumberMatrix[]
  competencies   Competency[]
  rides          Ride[]
}

model NumberMatrix {
  tierId     String
  tier       Tier     @relation(fields: [tierId], references: [id])
  positionId String
  position   Position @relation(fields: [positionId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  time       Int // in days

  @@id([tierId, positionId, categoryId])
}

model Ride {
  id          String  @id @default(uuid())
  name        String
  description String?
  tierId      String
  tier        Tier    @relation(fields: [tierId], references: [id])

  businessId   String
  business     Business     @relation(fields: [businessId], references: [id])
  competencies Competency[]
  positions    Position[]
}

model Competency {
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id])
  rideId        String
  ride          Ride        @relation(fields: [rideId], references: [id])
  positionId    String
  position      Position    @relation(fields: [positionId], references: [id])

  achievedAt     DateTime  @default(now())
  last_rotatedAt DateTime?

  @@id([staffMemberId, rideId, positionId])
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
}

model Permission {
  slug     String           @id @unique
  resource String
  action   PermissionAction
  roles    Role[]           @relation("RolePermissions")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  permissions Permission[] @relation("RolePermissions")
  identities  Identity[]
}

model Identity {
  staffMemberId   String         @id @unique
  staffMember     StaffMember    @relation(fields: [staffMemberId], references: [id])
  email           String         @unique
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  role            Role           @relation(fields: [roleId], references: [id])
  roleId          String
  magicLinks      MagicLink[]
  refreshTokens   RefreshToken[]
}

model MagicLink {
  id         String    @id @default(uuid())
  identity   Identity  @relation(fields: [identityId], references: [staffMemberId])
  identityId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  ip         String?
  userAgent  String?
}

model RefreshToken {
  id            String        @id @default(uuid())
  identity      Identity      @relation(fields: [identityId], references: [staffMemberId])
  identityId    String
  jti           String        @unique
  tokenHash     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime      @default(now())
  rotatedFromId String?       @unique
  rotatedFrom   RefreshToken? @relation("RefreshTokenRotation", fields: [rotatedFromId], references: [id])
  rotatedTo     RefreshToken? @relation("RefreshTokenRotation")
}
